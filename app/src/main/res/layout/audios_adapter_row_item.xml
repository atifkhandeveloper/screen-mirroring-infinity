<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/audio_play_icon"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_60sdp"
    android:background="@color/white"
    android:padding="@dimen/_10sdp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/audio_icon"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/audio_icon" />

        <TextView
            android:id="@+id/audio_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_toEndOf="@+id/audio_icon"
            android:text="@string/dummy"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/audio_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/audio_name_tv"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_toEndOf="@+id/audio_icon"
            android:text="@string/dummy"
            android:textColor="@color/black" />

        <ImageView
            android:id="@+id/play_audio_icon"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/play" />

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_below="@+id/audio_duration"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="#d4d4e3" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
